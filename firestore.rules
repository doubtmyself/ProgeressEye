rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // appConfig: public read, admin-only write (Firebase Console)
    match /appConfig/{document} {
      allow read: if true;
      allow write: if false;
    }

    // users: owner can read/create/update (plan 필드는 관리자만 변경 가능)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('plan' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
