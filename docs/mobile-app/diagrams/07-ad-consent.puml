@startuml
!theme plain
title 광고 동의 다이얼로그 버튼 (앱 시작 / 재동의)

skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam swimlane {
  BorderColor #334155
  TitleBackgroundColor #334155
  TitleFontColor #FFFFFF
}
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #000000
  StartColor #334155
  EndColor #334155
  BarColor #334155
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #FBC02D
  FontColor #000000
}
skinparam ArrowColor #334155

|앱|
start
:requestConsentAndInitAds() 호출\n(MainActivity.onCreate 또는 재동의 요청);

|UMP SDK|
#FEF3C7:requestConsentInfoUpdate();

if (기존 동의 있음 &&\n맞춤형 광고 허용?) then (yes)

  |앱|
  :initMobileAds() 즉시 호출\nMobileAds.initialize();
  #F1F5F9:광고 초기화 완료;
  stop

else (폼 필요 / 신규)

  #FEF3C7:loadAndShowConsentFormIfRequired()\nUMP 동의 폼 표시;

  |사용자|
  if (동의 선택?) then (맞춤형 광고 동의)

    |앱|
    :initMobileAds();
    #F1F5F9:광고 초기화 완료;
    stop

  elseif (비맞춤형 선택 / X 닫기\n/ 판매 거부 / 완전 거부) then

    |앱|
    :showConsentRequiredDialog()\n"광고 동의가 필요합니다" 다이얼로그;

    |사용자|
    if (선택?) then (재동의)

      |앱|
      if (EEA 지역?) then (yes)
        :UMP 동의 정보 리셋\nconsentInformation.reset();
        :requestConsentAndInitAds() 재호출;
        note right: 이 흐름 반복
        stop
      else (US 주)
        :개인정보 옵션 폼 재표시\nonShowPrivacyOptions();
        stop
      endif

    else (Pro 구독 클릭)

      |앱|
      :startProSubscription() 호출\n(Google Play 결제 창 표시);

      if (결제 성공?) then (yes)
        :userPlan = "pro" 업데이트;
        :isAdFreeMode = true;
        #F1F5F9:로그인 화면 진입 허용\n(Pro 혜택 적용);
        stop
      else (no / 취소)
        #FFF9C4:결제 실패 알림 표시;
        :showConsentRequiredDialog() 재표시;
        note right: 광고 동의 또는 구독 성공 전까지\n이 루프를 벗어날 수 없음
        stop
      endif

    endif

  endif

endif

@enduml
