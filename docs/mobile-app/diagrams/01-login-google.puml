@startuml
!theme plain
title "Google로 계속" 버튼 — 로그인 화면

skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #000000
  StartColor #334155
  EndColor #334155
  BarColor #334155
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #FBC02D
  FontColor #000000
}
skinparam ArrowColor #334155

start

#E0F2FE:**[버튼] "Google로 계속" 탭**;

:isLoading = true / error = null;
#FEF3C7:Google One Tap 인증 시작;

if (인증 결과?) then (성공)

  #FEF3C7:탈퇴 상태 조회\ngetWithdrawalStateUseCase(uid);

  if (탈퇴 유예 중?\npending == true\n&& deleteAt > now) then (yes)

    #F1F5F9:requiresWithdrawalCancel = true;
    note right
      → 03-withdrawal-dialog.puml
    end note
    stop

  elseif (재가입 제한 기간?\nrejoinAllowedAt > now) then (yes)

    #FEF3C7:Firebase 로그아웃;
    #F1F5F9:에러 메시지 표시\n"○○까지 재가입 불가";
    stop

  else (정상)

    #FEF3C7:기존 모바일 세션 조회\ncheckExistingSessionUseCase(uid, deviceId);

    if (다른 기기에 활성 세션 존재?) then (yes)

      #F1F5F9:requiresSessionTakeover = true\nexistingDeviceName 저장;
      note right
        → 02-session-takeover.puml
      end note
      stop

    else (없음)

      #FEF3C7:모바일 세션 등록\nactivateMobileSessionUseCase();
      :로컬 sessionId 저장;
      #FEF3C7:users 문서 업데이트 (백그라운드);
      :AuthUiState(user = user);
      #F1F5F9:메인 화면으로 이동 ("main");
      stop

    endif
  endif

elseif (취소됨) then

  :isLoading = false;
  #F1F5F9:에러: "로그인이 취소되었습니다";
  stop

else (네트워크 / 기타 오류)

  :isLoading = false;
  #F1F5F9:에러 메시지 표시;
  stop

endif

@enduml
