@startuml
!theme plain
title 세션 인수 다이얼로그 버튼

skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam swimlane {
  BorderColor #334155
  TitleBackgroundColor #334155
  TitleFontColor #FFFFFF
}
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #000000
  StartColor #334155
  EndColor #334155
  BarColor #334155
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #FBC02D
  FontColor #000000
}
skinparam ArrowColor #334155

|사용자|
start
:세션 인수 다이얼로그 확인\n"다른 기기(existingDeviceName)에서\n이미 로그인 중입니다.";

if (선택?) then (이 기기로 가져오기)

  |앱|
  :confirmSessionTakeover()\nisLoading = true;

  |Firebase RTDB|
  #FEF3C7:mobileSession 덮어쓰기\nactivateMobileSessionUseCase();

  |앱|
  :로컬 sessionId 저장;
  :pendingUser / pendingUid 초기화;
  :AuthUiState(user = user);

  |사용자|
  #F1F5F9:메인 화면으로 이동 ("main");
  stop

else (취소)

  |앱|
  :cancelSessionTakeover();

  |Firebase Auth|
  #FEF3C7:Firebase 로그아웃;

  |앱|
  :로컬 세션 초기화\nMobileSessionManager.clearSession();
  :pendingUser / pendingUid 초기화;
  #F1F5F9:에러: "세션 인수가 취소되었습니다";

  |사용자|
  :로그인 화면 유지\n(에러 메시지 표시);
  stop

endif

@enduml
