{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": [
    {
      "database": "progress",
      "rules": "firestore.rules"
    }
  ],
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "privacy-policy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true
  }
}
