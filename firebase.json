{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": [
    {
      "database": "progress",
      "rules": "firestore.rules"
    }
  ],
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "privacy-policy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/app-ads.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
